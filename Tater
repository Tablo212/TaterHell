<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>3D Spud Survivor - NIGHTMARE HORDE EDITION</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; user-select: none; }
  body { overflow: hidden; background: #141418; color: #fff; }
  #game-canvas { display: block; width: 100vw; height: 100vh; }

  /* HUD */
  #hud { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; }
  .top-bar { display: flex; justify-content: space-between; align-items: flex-start; }
  .stats-box { background: rgba(15, 15, 20, 0.88); border: 2px solid #444; padding: 12px 18px; border-radius: 8px; min-width: 240px; }
  .bar-container { width: 100%; height: 18px; background: #333; border-radius: 4px; overflow: hidden; margin: 6px 0; position: relative; }
  #hp-bar { width: 100%; height: 100%; background: #e74c3c; transition: width 0.1s; }
  #xp-bar { width: 0%; height: 100%; background: #3498db; transition: width 0.1s; }
  .bar-text { position: absolute; top: 0; left: 0; width: 100%; text-align: center; font-size: 12px; font-weight: bold; line-height: 18px; text-shadow: 1px 1px 2px #000; }

  .wave-info { text-align: center; background: rgba(15, 15, 20, 0.88); border: 2px solid #e74c3c; padding: 10px 30px; border-radius: 8px; }
  #wave-title { font-size: 24px; font-weight: 900; color: #ff4757; letter-spacing: 2px; }
  #wave-timer { font-size: 36px; font-weight: bold; color: #fff; }
  .nightmare-tag { font-size: 11px; color: #ffa502; text-transform: uppercase; letter-spacing: 1px; }

  .right-column { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
  .right-stats { text-align: right; }
  .stat-line { font-size: 15px; margin-bottom: 4px; font-weight: 600; }
  .mat-color { color: #2ed573; }

  /* MINIMAP */
  .minimap-box { background: rgba(15, 15, 20, 0.9); border: 2px solid #555; border-radius: 8px; padding: 6px; text-align: center; }
  #minimap-canvas { display: block; background: #1a1d24; border: 1px solid #333; border-radius: 4px; }
  .minimap-label { font-size: 10px; color: #aaa; margin-top: 4px; letter-spacing: 1px; font-weight: bold; }

  /* MODALS */
  .modal { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.85); display: none; flex-direction: column; justify-content: center; align-items: center; pointer-events: auto; z-index: 10; }
  .modal h1 { font-size: 42px; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 2px; }
  .modal p { font-size: 18px; margin-bottom: 25px; color: #ccc; }

  .cards-container { display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; justify-content: center; max-width: 900px; }
  .card { background: #1e2229; border: 2px solid #555; border-radius: 10px; padding: 20px; width: 220px; text-align: center; cursor: pointer; transition: transform 0.15s, border-color 0.15s; }
  .card:hover { transform: translateY(-5px); border-color: #ffa502; }
  .card h3 { color: #ffa502; margin-bottom: 10px; font-size: 18px; }
  .card .stat-desc { font-size: 14px; color: #a4b0be; margin-bottom: 15px; min-height: 40px; }
  .card .nerf-note { font-size: 11px; color: #ff6b81; margin-bottom: 10px; font-style: italic; }

  .btn { background: #e74c3c; color: #fff; border: none; padding: 14px 32px; font-size: 18px; font-weight: bold; border-radius: 6px; cursor: pointer; text-transform: uppercase; transition: background 0.2s; }
  .btn:hover { background: #ff6b81; }
  .btn-buy { background: #2ed573; color: #111; padding: 8px 16px; font-size: 14px; width: 100%; }
  .btn-buy:disabled { background: #555; color: #888; cursor: not-allowed; }
  .btn-reroll { background: #3742fa; margin-bottom: 20px; padding: 10px 20px; font-size: 14px; }

  #controls-hint { font-size: 13px; color: #aaa; text-align: center; }
</style>
</head>
<body>

<canvas id="game-canvas"></canvas>

<div id="hud">
  <div class="top-bar">
    <div class="stats-box">
      <div class="bar-container">
        <div id="hp-bar"></div>
        <div class="bar-text" id="hp-text">HP: 75/75</div>
      </div>
      <div class="bar-container">
        <div id="xp-bar"></div>
        <div class="bar-text" id="xp-text">LEVEL 1 (0/35 XP)</div>
      </div>
      <div class="stat-line">Materials: <span id="mat-text" class="mat-color">0</span></div>
    </div>

    <div class="wave-info">
      <div class="nightmare-tag">10X NIGHTMARE DIFFICULTY</div>
      <div id="wave-title">WAVE 1</div>
      <div id="wave-timer">35</div>
    </div>

    <div class="right-column">
      <div class="stats-box right-stats">
        <div class="stat-line">Weapons: <span id="wep-text">1/6</span></div>
        <div class="stat-line">Enemies Alive: <span id="alive-text">0</span></div>
        <div class="stat-line">Total Kills: <span id="kills-text">0</span></div>
        <div class="stat-line" style="font-size: 12px; color: #888; margin-top: 6px;" id="player-stats-summary">DMG: 100% | ASPD: 100% | ARM: 0</div>
      </div>

      <div class="minimap-box">
        <canvas id="minimap-canvas" width="150" height="150"></canvas>
        <div class="minimap-label">TACTICAL ARENA MAP</div>
      </div>
    </div>
  </div>
  <div id="controls-hint">WASD / Arrow Keys to Move â€¢ Use Cover Pillars â€¢ Dodge Red Projectiles!</div>
</div>

<!-- LEVEL UP MODAL -->
<div id="levelup-modal" class="modal">
  <h1 style="color: #3498db;">LEVEL UP!</h1>
  <p>Choose a heavily nerfed stat boost:</p>
  <div class="cards-container" id="levelup-cards"></div>
</div>

<!-- SHOP MODAL -->
<div id="shop-modal" class="modal">
  <h1 style="color: #2ed573;">WAVE COMPLETE!</h1>
  <p>Materials Available: <span id="shop-mat-text" class="mat-color" style="font-weight:bold;">0</span></p>
  <button class="btn btn-reroll" id="reroll-btn">Reroll Shop (Cost: 25)</button>
  <div class="cards-container" id="shop-cards"></div>
  <button class="btn" id="next-wave-btn">START WAVE 2</button>
</div>

<!-- GAME OVER MODAL -->
<div id="gameover-modal" class="modal">
  <h1 style="color: #ff4757;">YOU GOT MASHED!</h1>
  <p id="gameover-stats">Survived to Wave 1 | Total Kills: 0</p>
  <button class="btn" onclick="location.reload()">PLAY AGAIN</button>
</div>

<script>
(function() {
  const canvas = document.getElementById('game-canvas');
  const ctx = canvas.getContext('2d');
  const miniCanvas = document.getElementById('minimap-canvas');
  const miniCtx = miniCanvas.getContext('2d');

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resize);
  resize();

  const CONFIG = {
    arenaRadius: 1100,
    baseWaveDuration: 35,
    waveTimeScale: 3,
    xpRequirementScale: 1.45,
    baseXpReq: 35,
    enemySpawnRateBase: 0.75,
    enemyHpScale: 1.45,
    enemyDmgScale: 1.30,
    shopInflation: 1.35,
    rerollBaseCost: 25
  };

  let state = {
    paused: false,
    gameOver: false,
    wave: 1,
    waveTimer: CONFIG.baseWaveDuration,
    kills: 0,
    materials: 0,
    xp: 0,
    level: 1,
    xpToNext: CONFIG.baseXpReq,
    pendingLevelUps: 0,
    rerollCost: CONFIG.rerollBaseCost,
    player: {
      x: 0,
      y: 0,
      radius: 22,
      facing: 0,
      hp: 75,
      maxHp: 75,
      speed: 290,
      damageMult: 1.0,
      attackSpeedMult: 1.0,
      armor: 0,
      pickupRange: 110,
      critChance: 0.02,
      weapons: []
    }
  };

  // Tactical Arena Cover Pillars
  const pillars = [
    { x: -380, y: -320, r: 55 },
    { x:  380, y: -320, r: 55 },
    { x: -380, y:  320, r: 55 },
    { x:  380, y:  320, r: 55 },
    { x:    0, y: -520, r: 45 },
    { x:    0, y:  520, r: 45 },
    { x: -580, y:    0, r: 45 },
    { x:  580, y:    0, r: 45 }
  ];

  const NERFED_UPGRADES = [
    { name: "Sprout Skin", desc: "+4 Max HP", nerf: "(Nerfed from +15)", apply: () => { state.player.maxHp += 4; state.player.hp += 4; } },
    { name: "Dull Peeler", desc: "+4% Damage", nerf: "(Nerfed from +15%)", apply: () => { state.player.damageMult += 0.04; } },
    { name: "Slightly Oiled", desc: "+5% Attack Speed", nerf: "(Nerfed from +15%)", apply: () => { state.player.attackSpeedMult += 0.05; } },
    { name: "Cardboard Vest", desc: "+1 Armor", nerf: "(Flat reduction, diminishes fast)", apply: () => { state.player.armor += 1; } },
    { name: "Tiny Boots", desc: "+3% Move Speed", nerf: "(Nerfed from +10%)", apply: () => { state.player.speed *= 1.03; } },
    { name: "Weak Magnet", desc: "+10% Pickup Range", nerf: "(Nerfed from +35%)", apply: () => { state.player.pickupRange *= 1.10; } },
    { name: "Lucky Eye", desc: "+2% Crit Chance", nerf: "(Nerfed from +8%)", apply: () => { state.player.critChance += 0.02; } }
  ];

  const SHOP_POOL = [
    { type: 'weapon', id: 'peashooter', name: "Spud Pistol", basePrice: 45, desc: "Basic ranged pea shooter. Fast fire, low damage." },
    { type: 'weapon', id: 'shotgun', name: "Mash Blaster", basePrice: 85, desc: "Fires 4 pellets in a spread. Slow reload." },
    { type: 'weapon', id: 'sniper', name: "Fry Railgun", basePrice: 110, desc: "High damage, piercing shot, very slow cooldown." },
    { type: 'stat', name: "Stale Bread", basePrice: 40, desc: "+6 Max HP & Heal 10 HP", apply: () => { state.player.maxHp += 6; state.player.hp = Math.min(state.player.maxHp, state.player.hp + 10); } },
    { type: 'stat', name: "Rusty Scope", basePrice: 55, desc: "+6% Damage, -2% Move Speed", apply: () => { state.player.damageMult += 0.06; state.player.speed *= 0.98; } },
    { type: 'stat', name: "Tin Foil Hat", basePrice: 65, desc: "+1 Armor, +3 Max HP", apply: () => { state.player.armor += 1; state.player.maxHp += 3; state.player.hp += 3; } },
    { type: 'stat', name: "Energy Starch", basePrice: 60, desc: "+7% Attack Speed", apply: () => { state.player.attackSpeedMult += 0.07; } }
  ];

  let enemies = [];
  let playerBullets = [];
  let enemyBullets = [];
  let drops = [];
  let invulnTimer = 0;
  let spawnTimer = 0;
  let elapsedTime = 0;

  function addWeapon(id) {
    if (state.player.weapons.length >= 6) return;
    const defs = {
      peashooter: { id: 'peashooter', name: "Spud Pistol", dmg: 9, cd: 0.55, speed: 750, color: '#f1c40f', count: 1, spread: 0 },
      shotgun:    { id: 'shotgun', name: "Mash Blaster", dmg: 6, cd: 1.25, speed: 640, color: '#e67e22', count: 4, spread: 0.35 },
      sniper:     { id: 'sniper', name: "Fry Railgun", dmg: 32, cd: 1.9, speed: 1100, color: '#00d2d3', count: 1, spread: 0, pierce: 2 }
    };
    state.player.weapons.push({ ...defs[id], timer: 0 });
  }

  addWeapon('peashooter');

  const keys = {};
  window.addEventListener('keydown', e => keys[e.code] = true);
  window.addEventListener('keyup', e => keys[e.code] = false);

  function resolveCircleObstacle(entity, radius) {
    // Keep inside arena boundary
    const distFromCenter = Math.hypot(entity.x, entity.y);
    const maxR = CONFIG.arenaRadius - radius;
    if (distFromCenter > maxR) {
      entity.x = (entity.x / distFromCenter) * maxR;
      entity.y = (entity.y / distFromCenter) * maxR;
    }
    // Push out of cover pillars
    for (let p of pillars) {
      const dx = entity.x - p.x;
      const dy = entity.y - p.y;
      const d = Math.hypot(dx, dy);
      const minDist = p.r + radius;
      if (d < minDist && d > 0.001) {
        entity.x = p.x + (dx / d) * minDist;
        entity.y = p.y + (dy / d) * minDist;
      }
    }
  }

  function spawnEnemy() {
    const angle = Math.random() * Math.PI * 2;
    const dist = CONFIG.arenaRadius - 60;
    const x = Math.cos(angle) * dist;
    const y = Math.sin(angle) * dist;

    const roll = Math.random();
    let type = 'rusher';
    if (state.wave >= 2 && roll > 0.65) type = 'shooter';
    if (state.wave >= 1 && roll > 0.82) type = 'brute';
    if (roll < 0.25) type = 'sprinter';

    const waveMultHp = Math.pow(CONFIG.enemyHpScale, state.wave - 1);
    const waveMultDmg = Math.pow(CONFIG.enemyDmgScale, state.wave - 1);

    let cfg = {
      rusher:   { hp: 28, speed: 185, dmg: 12, radius: 18, color: '#ff4757', xp: 5, mat: 2 },
      sprinter: { hp: 16, speed: 295, dmg: 10, radius: 14, color: '#ffa502', xp: 6, mat: 2 },
      shooter:  { hp: 35, speed: 130, dmg: 14, radius: 20, color: '#9b59b6', xp: 9, mat: 3, ranged: true, shootCd: 2.2 },
      brute:    { hp: 110, speed: 110, dmg: 24, radius: 34, color: '#8e0000', xp: 18, mat: 5 }
    }[type];

    enemies.push({
      x, y,
      type,
      hp: Math.round(cfg.hp * waveMultHp),
      maxHp: Math.round(cfg.hp * waveMultHp),
      speed: cfg.speed + (state.wave * 6),
      dmg: Math.round(cfg.dmg * waveMultDmg),
      radius: cfg.radius,
      color: cfg.color,
      xp: cfg.xp,
      mat: cfg.mat,
      ranged: cfg.ranged || false,
      shootTimer: Math.random() * 1.5,
      shootCd: cfg.shootCd || 2.5
    });
  }

  // Spawn initial enemies immediately
  for (let i = 0; i < 4; i++) spawnEnemy();

  function fireWeapon(wep) {
    if (enemies.length === 0) return;
    let nearest = null;
    let minDist = Infinity;
    for (let e of enemies) {
      const d = Math.hypot(e.x - state.player.x, e.y - state.player.y);
      if (d < minDist) { minDist = d; nearest = e; }
    }
    if (!nearest || minDist > 750) return;

    const baseAngle = Math.atan2(nearest.y - state.player.y, nearest.x - state.player.x);

    for (let i = 0; i < wep.count; i++) {
      const offset = (i - (wep.count - 1) / 2) * wep.spread;
      const angle = baseAngle + offset;
      const isCrit = Math.random() < state.player.critChance;
      const dmg = wep.dmg * state.player.damageMult * (isCrit ? 1.75 : 1.0);

      playerBullets.push({
        x: state.player.x,
        y: state.player.y,
        vx: Math.cos(angle) * wep.speed,
        vy: Math.sin(angle) * wep.speed,
        color: wep.color,
        dmg,
        life: 1.3,
        pierce: wep.pierce || 0,
        hitList: []
      });
    }
  }

  function fireEnemyBullet(enemy) {
    const angle = Math.atan2(state.player.y - enemy.y, state.player.x - enemy.x);
    enemyBullets.push({
      x: enemy.x,
      y: enemy.y,
      vx: Math.cos(angle) * 380,
      vy: Math.sin(angle) * 380,
      dmg: enemy.dmg,
      life: 3.0
    });
  }

  function spawnDrop(x, y, xp, mat) {
    drops.push({
      x: x + (Math.random() - 0.5) * 20,
      y: y + (Math.random() - 0.5) * 20,
      xp,
      mat
    });
  }

  function damagePlayer(rawDmg) {
    if (invulnTimer > 0 || state.gameOver) return;
    const mitigated = Math.max(2, Math.round(rawDmg - state.player.armor));
    state.player.hp -= mitigated;
    invulnTimer = 0.35;

    if (state.player.hp <= 0) {
      state.player.hp = 0;
      state.gameOver = true;
      state.paused = true;
      document.getElementById('gameover-stats').innerText =
        `Survived to Wave ${state.wave} | Level ${state.level} | Total Kills: ${state.kills}`;
      document.getElementById('gameover-modal').style.display = 'flex';
    }
    updateHUD();
  }

  function checkLevelUp() {
    while (state.xp >= state.xpToNext) {
      state.xp -= state.xpToNext;
      state.level++;
      state.xpToNext = Math.round(state.xpToNext * CONFIG.xpRequirementScale);
      state.pendingLevelUps++;
    }
    if (state.pendingLevelUps > 0 && !state.paused) {
      showLevelUpModal();
    }
  }

  function showLevelUpModal() {
    state.paused = true;
    const modal = document.getElementById('levelup-modal');
    const container = document.getElementById('levelup-cards');
    container.innerHTML = '';

    const choices = [...NERFED_UPGRADES].sort(() => 0.5 - Math.random()).slice(0, 3);
    choices.forEach(upg => {
      const card = document.createElement('div');
      card.className = 'card';
      card.innerHTML = `
        <h3>${upg.name}</h3>
        <div class="stat-desc">${upg.desc}</div>
        <div class="nerf-note">${upg.nerf}</div>
        <button class="btn btn-buy">SELECT</button>
      `;
      card.onclick = () => {
        upg.apply();
        state.pendingLevelUps--;
        modal.style.display = 'none';
        if (state.pendingLevelUps > 0) {
          showLevelUpModal();
        } else {
          state.paused = false;
          if (state.waveTimer <= 0) openShopModal();
        }
        updateHUD();
      };
      container.appendChild(card);
    });
    modal.style.display = 'flex';
  }

  function openShopModal() {
    state.paused = true;
    enemies = [];
    enemyBullets = [];
    playerBullets = [];
    drops.forEach(d => {
      state.xp += d.xp;
      state.materials += d.mat;
    });
    drops = [];

    state.rerollCost = Math.round(CONFIG.rerollBaseCost * Math.pow(1.25, state.wave - 1));
    document.getElementById('next-wave-btn').innerText = `START WAVE ${state.wave + 1}`;
    renderShopItems();
    document.getElementById('shop-modal').style.display = 'flex';
  }

  function getInflatedPrice(basePrice) {
    return Math.round(basePrice * Math.pow(CONFIG.shopInflation, state.wave - 1));
  }

  function renderShopItems() {
    document.getElementById('shop-mat-text').innerText = state.materials;
    const rerollBtn = document.getElementById('reroll-btn');
    rerollBtn.innerText = `Reroll Shop (Cost: ${state.rerollCost})`;
    rerollBtn.disabled = state.materials < state.rerollCost;

    const container = document.getElementById('shop-cards');
    container.innerHTML = '';

    const choices = [...SHOP_POOL].sort(() => 0.5 - Math.random()).slice(0, 3);
    choices.forEach(item => {
      const price = getInflatedPrice(item.basePrice);
      const wepFull = item.type === 'weapon' && state.player.weapons.length >= 6;
      const canAfford = state.materials >= price && !wepFull;

      const card = document.createElement('div');
      card.className = 'card';
      card.innerHTML = `
        <h3>${item.name}</h3>
        <div class="stat-desc">${item.desc}</div>
        <div class="nerf-note">10x Inflation Active</div>
        <button class="btn btn-buy" ${!canAfford ? 'disabled' : ''}>
          ${wepFull ? 'SLOTS FULL' : `BUY (${price} MAT)`}
        </button>
      `;
      const btn = card.querySelector('button');
      btn.onclick = () => {
        if (state.materials < price) return;
        state.materials -= price;
        if (item.type === 'weapon') addWeapon(item.id);
        else item.apply();
        btn.disabled = true;
        btn.innerText = "SOLD OUT";
        document.getElementById('shop-mat-text').innerText = state.materials;
        rerollBtn.disabled = state.materials < state.rerollCost;
        updateHUD();
      };
      container.appendChild(card);
    });
  }

  document.getElementById('reroll-btn').onclick = () => {
    if (state.materials >= state.rerollCost) {
      state.materials -= state.rerollCost;
      state.rerollCost = Math.round(state.rerollCost * 1.5);
      renderShopItems();
      updateHUD();
    }
  };

  document.getElementById('next-wave-btn').onclick = () => {
    state.wave++;
    state.waveTimer = CONFIG.baseWaveDuration + (state.wave - 1) * CONFIG.waveTimeScale;
    state.player.hp = Math.min(state.player.maxHp, state.player.hp + Math.ceil(state.player.maxHp * 0.1));
    document.getElementById('shop-modal').style.display = 'none';
    state.paused = false;
    updateHUD();
  };

  function updateHUD() {
    const hpPct = Math.max(0, (state.player.hp / state.player.maxHp) * 100);
    document.getElementById('hp-bar').style.width = hpPct + '%';
    document.getElementById('hp-text').innerText = `HP: ${state.player.hp}/${state.player.maxHp}`;

    const xpPct = Math.min(100, (state.xp / state.xpToNext) * 100);
    document.getElementById('xp-bar').style.width = xpPct + '%';
    document.getElementById('xp-text').innerText = `LEVEL ${state.level} (${state.xp}/${state.xpToNext} XP)`;

    document.getElementById('mat-text').innerText = state.materials;
    document.getElementById('wave-title').innerText = `WAVE ${state.wave}`;
    document.getElementById('wave-timer').innerText = Math.ceil(state.waveTimer);
    document.getElementById('wep-text').innerText = `${state.player.weapons.length}/6`;
    document.getElementById('alive-text').innerText = enemies.length;
    document.getElementById('kills-text').innerText = state.kills;
    document.getElementById('player-stats-summary').innerText =
      `DMG: ${Math.round(state.player.damageMult * 100)}% | ASPD: ${Math.round(state.player.attackSpeedMult * 100)}% | ARM: ${state.player.armor}`;
  }

  function update(dt) {
    if (state.paused || state.gameOver) return;
    elapsedTime += dt;

    if (invulnTimer > 0) invulnTimer -= dt;

    state.waveTimer -= dt;
    if (state.waveTimer <= 0) {
      state.waveTimer = 0;
      updateHUD();
      openShopModal();
      return;
    }

    // Player Movement
    let moveX = 0, moveY = 0;
    if (keys['KeyW'] || keys['ArrowUp']) moveY -= 1;
    if (keys['KeyS'] || keys['ArrowDown']) moveY += 1;
    if (keys['KeyA'] || keys['ArrowLeft']) moveX -= 1;
    if (keys['KeyD'] || keys['ArrowRight']) moveX += 1;

    if (moveX !== 0 || moveY !== 0) {
      const len = Math.hypot(moveX, moveY);
      moveX /= len; moveY /= len;
      state.player.x += moveX * state.player.speed * dt;
      state.player.y += moveY * state.player.speed * dt;
      state.player.facing = Math.atan2(moveY, moveX);
    }
    resolveCircleObstacle(state.player, state.player.radius);

    // Weapon Cooldowns
    state.player.weapons.forEach(w => {
      w.timer -= dt * state.player.attackSpeedMult;
      if (w.timer <= 0) {
        fireWeapon(w);
        w.timer = w.cd;
      }
    });

    // Enemy Spawning
    spawnTimer -= dt;
    const currentSpawnInterval = Math.max(0.16, CONFIG.enemySpawnRateBase / (1 + (state.wave - 1) * 0.45));
    if (spawnTimer <= 0) {
      const burst = state.wave >= 3 ? 2 : 1;
      for (let i = 0; i < burst; i++) spawnEnemy();
      spawnTimer = currentSpawnInterval;
    }

    // Update Enemies
    for (let i = enemies.length - 1; i >= 0; i--) {
      const e = enemies[i];
      const dx = state.player.x - e.x;
      const dy = state.player.y - e.y;
      const dist = Math.hypot(dx, dy);

      if (dist > 1) {
        if (!e.ranged || dist > 360) {
          e.x += (dx / dist) * e.speed * dt;
          e.y += (dy / dist) * e.speed * dt;
        }
      }
      resolveCircleObstacle(e, e.radius);

      if (e.ranged) {
        e.shootTimer -= dt;
        if (e.shootTimer <= 0 && dist < 680) {
          fireEnemyBullet(e);
          e.shootTimer = e.shootCd;
        }
      }

      if (dist < e.radius + state.player.radius) {
        damagePlayer(e.dmg);
      }
    }

    // Update Player Bullets
    for (let i = playerBullets.length - 1; i >= 0; i--) {
      const b = playerBullets[i];
      b.x += b.vx * dt;
      b.y += b.vy * dt;
      b.life -= dt;

      let remove = b.life <= 0 || Math.hypot(b.x, b.y) > CONFIG.arenaRadius;

      // Pillar collision blocks bullets
      for (let p of pillars) {
        if (Math.hypot(b.x - p.x, b.y - p.y) < p.r) {
          remove = true;
          break;
        }
      }

      if (!remove) {
        for (let j = enemies.length - 1; j >= 0; j--) {
          const e = enemies[j];
          if (b.hitList.includes(e)) continue;
          if (Math.hypot(b.x - e.x, b.y - e.y) < e.radius + 7) {
            e.hp -= b.dmg;
            b.hitList.push(e);
            if (e.hp <= 0) {
              spawnDrop(e.x, e.y, e.xp, e.mat);
              enemies.splice(j, 1);
              state.kills++;
            }
            if (b.pierce > 0) b.pierce--;
            else { remove = true; break; }
          }
        }
      }

      if (remove) playerBullets.splice(i, 1);
    }

    // Update Enemy Bullets
    for (let i = enemyBullets.length - 1; i >= 0; i--) {
      const b = enemyBullets[i];
      b.x += b.vx * dt;
      b.y += b.vy * dt;
      b.life -= dt;

      let remove = b.life <= 0 || Math.hypot(b.x, b.y) > CONFIG.arenaRadius;
      for (let p of pillars) {
        if (Math.hypot(b.x - p.x, b.y - p.y) < p.r) {
          remove = true;
          break;
        }
      }

      if (!remove && Math.hypot(b.x - state.player.x, b.y - state.player.y) < state.player.radius + 8) {
        damagePlayer(b.dmg);
        remove = true;
      }

      if (remove) enemyBullets.splice(i, 1);
    }

    // Update Drops
    for (let i = drops.length - 1; i >= 0; i--) {
      const d = drops[i];
      const dx = state.player.x - d.x;
      const dy = state.player.y - d.y;
      const dist = Math.hypot(dx, dy);

      if (dist < state.player.pickupRange && dist > 1) {
        d.x += (dx / dist) * 460 * dt;
        d.y += (dy / dist) * 460 * dt;
      }

      if (dist < state.player.radius + 14) {
        state.xp += d.xp;
        state.materials += d.mat;
        drops.splice(i, 1);
        checkLevelUp();
      }
    }

    updateHUD();
  }

  function render() {
    ctx.fillStyle = '#141418';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.save();
    ctx.translate(canvas.width / 2 - state.player.x, canvas.height / 2 - state.player.y);

    // Arena Floor
    ctx.beginPath();
    ctx.arc(0, 0, CONFIG.arenaRadius, 0, Math.PI * 2);
    ctx.fillStyle = '#1e2128';
    ctx.fill();
    ctx.lineWidth = 8;
    ctx.strokeStyle = '#ff4757';
    ctx.stroke();

    // Arena Grid
    ctx.save();
    ctx.clip();
    ctx.strokeStyle = '#292d36';
    ctx.lineWidth = 2;
    const gridSize = 100;
    for (let gx = -CONFIG.arenaRadius; gx <= CONFIG.arenaRadius; gx += gridSize) {
      ctx.beginPath();
      ctx.moveTo(gx, -CONFIG.arenaRadius);
      ctx.lineTo(gx, CONFIG.arenaRadius);
      ctx.stroke();
    }
    for (let gy = -CONFIG.arenaRadius; gy <= CONFIG.arenaRadius; gy += gridSize) {
      ctx.beginPath();
      ctx.moveTo(-CONFIG.arenaRadius, gy);
      ctx.lineTo(CONFIG.arenaRadius, gy);
      ctx.stroke();
    }
    ctx.restore();

    // Cover Pillars (2.5D Extruded Look)
    for (let p of pillars) {
      ctx.beginPath();
      ctx.arc(p.x, p.y + 10, p.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(0,0,0,0.45)';
      ctx.fill();

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = '#3d4452';
      ctx.fill();
      ctx.lineWidth = 4;
      ctx.strokeStyle = '#57606f';
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(p.x, p.y - 6, p.r * 0.85, 0, Math.PI * 2);
      ctx.fillStyle = '#4b5262';
      ctx.fill();
    }

    // Material Drops
    for (let d of drops) {
      ctx.save();
      ctx.translate(d.x, d.y);
      ctx.rotate(elapsedTime * 3);
      ctx.fillStyle = '#2ed573';
      ctx.fillRect(-7, -7, 14, 14);
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(-7, -7, 14, 14);
      ctx.restore();
    }

    // Enemies
    for (let e of enemies) {
      // Shadow
      ctx.beginPath();
      ctx.ellipse(e.x, e.y + e.radius * 0.8, e.radius * 0.9, e.radius * 0.45, 0, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(0,0,0,0.4)';
      ctx.fill();

      // Body
      ctx.beginPath();
      ctx.arc(e.x, e.y, e.radius, 0, Math.PI * 2);
      ctx.fillStyle = e.color;
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = '#111';
      ctx.stroke();

      // Health Bar above damaged enemies
      if (e.hp < e.maxHp) {
        const bw = e.radius * 2;
        ctx.fillStyle = '#222';
        ctx.fillRect(e.x - bw / 2, e.y - e.radius - 12, bw, 5);
        ctx.fillStyle = '#ff4757';
        ctx.fillRect(e.x - bw / 2, e.y - e.radius - 12, bw * Math.max(0, e.hp / e.maxHp), 5);
      }
    }

    // Player Bullets
    for (let b of playerBullets) {
      ctx.beginPath();
      ctx.arc(b.x, b.y, 6, 0, Math.PI * 2);
      ctx.fillStyle = b.color;
      ctx.fill();
    }

    // Enemy Bullets
    for (let b of enemyBullets) {
      ctx.beginPath();
      ctx.arc(b.x, b.y, 8, 0, Math.PI * 2);
      ctx.fillStyle = '#ff0055';
      ctx.fill();
      ctx.lineWidth = 2;
      ctx.strokeStyle = '#fff';
      ctx.stroke();
    }

    // Player Character (The Spud)
    const p = state.player;
    ctx.beginPath();
    ctx.ellipse(p.x, p.y + 16, 20, 10, 0, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(0,0,0,0.45)';
    ctx.fill();

    ctx.beginPath();
    ctx.ellipse(p.x, p.y, 20, 26, 0, 0, Math.PI * 2);
    ctx.fillStyle = invulnTimer > 0 ? '#ff4757' : '#d4a373';
    ctx.fill();
    ctx.lineWidth = 3;
    ctx.strokeStyle = '#6f4e37';
    ctx.stroke();

    // Eyes facing movement direction
    const eyeOffsetX = Math.cos(p.facing) * 8;
    const eyeOffsetY = Math.sin(p.facing) * 8;
    ctx.fillStyle = '#111';
    ctx.beginPath();
    ctx.arc(p.x + eyeOffsetX - 5, p.y + eyeOffsetY - 4, 3.2, 0, Math.PI * 2);
    ctx.arc(p.x + eyeOffsetX + 5, p.y + eyeOffsetY - 4, 3.2, 0, Math.PI * 2);
    ctx.fill();

    // Orbiting Weapons
    p.weapons.forEach((w, idx) => {
      const angle = elapsedTime * 2.5 + (idx / p.weapons.length) * Math.PI * 2;
      const wx = p.x + Math.cos(angle) * 38;
      const wy = p.y + Math.sin(angle) * 38;
      ctx.save();
      ctx.translate(wx, wy);
      ctx.rotate(angle);
      ctx.fillStyle = w.color;
      ctx.fillRect(-8, -4, 16, 8);
      ctx.strokeStyle = '#111';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(-8, -4, 16, 8);
      ctx.restore();
    });

    ctx.restore();

    // Render Tactical Minimap
    renderMinimap();
  }

  function renderMinimap() {
    const mw = miniCanvas.width;
    const mh = miniCanvas.height;
    const cx = mw / 2;
    const cy = mh / 2;
    const scale = (mw / 2 - 8) / CONFIG.arenaRadius;

    miniCtx.clearRect(0, 0, mw, mh);

    // Arena Circle
    miniCtx.beginPath();
    miniCtx.arc(cx, cy, CONFIG.arenaRadius * scale, 0, Math.PI * 2);
    miniCtx.fillStyle = '#181b22';
    miniCtx.fill();
    miniCtx.lineWidth = 2;
    miniCtx.strokeStyle = '#ff4757';
    miniCtx.stroke();

    // Pillars
    miniCtx.fillStyle = '#57606f';
    for (let p of pillars) {
      miniCtx.beginPath();
      miniCtx.arc(cx + p.x * scale, cy + p.y * scale, p.r * scale, 0, Math.PI * 2);
      miniCtx.fill();
    }

    // Material Drops
    miniCtx.fillStyle = '#2ed573';
    for (let d of drops) {
      miniCtx.fillRect(cx + d.x * scale - 1.5, cy + d.y * scale - 1.5, 3, 3);
    }

    // Enemies
    for (let e of enemies) {
      miniCtx.fillStyle = e.color;
      miniCtx.beginPath();
      miniCtx.arc(cx + e.x * scale, cy + e.y * scale, e.type === 'brute' ? 4 : 2.5, 0, Math.PI * 2);
      miniCtx.fill();
    }

    // Player Dot & Facing Pointer
    const px = cx + state.player.x * scale;
    const py = cy + state.player.y * scale;
    miniCtx.strokeStyle = '#fff';
    miniCtx.lineWidth = 1.5;
    miniCtx.beginPath();
    miniCtx.moveTo(px, py);
    miniCtx.lineTo(px + Math.cos(state.player.facing) * 9, py + Math.sin(state.player.facing) * 9);
    miniCtx.stroke();

    miniCtx.fillStyle = '#f1c40f';
    miniCtx.beginPath();
    miniCtx.arc(px, py, 3.5, 0, Math.PI * 2);
    miniCtx.fill();
  }

  let lastTime = performance.now();
  function loop(now) {
    const dt = Math.min((now - lastTime) / 1000, 0.1);
    lastTime = now;
    update(dt);
    render();
    requestAnimationFrame(loop);
  }

  updateHUD();
  render();
  requestAnimationFrame(loop);
})();
</script>
</body>
