<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>TaterHell - Brutal Brotato Clone</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; user-select: none; }
  body {
    background-color: #0d0d10;
    color: #fff;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
  }
  canvas {
    background-color: #18181f;
    box-shadow: 0 0 40px rgba(255, 40, 40, 0.25);
    border: 3px solid #3a1c1c;
    display: block;
  }
  #ui-layer {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
  }
  .hud-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
  }
  .bars { width: 260px; }
  .bar-container {
    width: 100%; height: 22px; background: #222;
    border: 2px solid #444; border-radius: 4px;
    margin-bottom: 6px; position: relative; overflow: hidden;
  }
  .bar-fill { height: 100%; transition: width 0.1s; }
  #hp-fill { background: #e62e2e; width: 100%; }
  #xp-fill { background: #2eb8e6; width: 0%; }
  .bar-text {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: bold; text-shadow: 1px 1px 2px #000;
  }
  .wave-info { text-align: center; }
  #wave-num { font-size: 28px; font-weight: 900; color: #ff4d4d; letter-spacing: 2px; }
  #wave-timer { font-size: 42px; font-weight: bold; font-variant-numeric: tabular-nums; }
  .resources { text-align: right; font-size: 20px; font-weight: bold; }
  #mat-count { color: #5ce65c; }
  
  /* Modals */
  .modal {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(10, 10, 14, 0.92);
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    pointer-events: auto; z-index: 10;
  }
  .hidden { display: none !important; }
  h1 { font-size: 54px; color: #ff3333; text-shadow: 0 0 15px #990000; margin-bottom: 10px; }
  p.subtitle { color: #aaa; margin-bottom: 30px; font-size: 18px; max-width: 620px; text-align: center; }
  button {
    background: #cc2929; color: white; border: 2px solid #ff6666;
    padding: 14px 32px; font-size: 20px; font-weight: bold;
    border-radius: 6px; cursor: pointer; transition: 0.15s;
  }
  button:hover:not(:disabled) { background: #ff3333; transform: scale(1.05); }
  
  .cards-container {
    display: flex; gap: 20px; margin: 20px 0; flex-wrap: wrap; justify-content: center;
  }
  .card {
    background: #22222b; border: 2px solid #444; border-radius: 8px;
    width: 235px; padding: 20px; text-align: center;
    display: flex; flex-direction: column; justify-content: space-between;
    transition: 0.15s;
  }
  .card:hover { border-color: #ff4d4d; transform: translateY(-5px); }
  .card h3 { color: #ffcc00; margin-bottom: 10px; font-size: 20px; }
  .card p { font-size: 14px; color: #ccc; margin-bottom: 15px; line-height: 1.4; }
  .card button { width: 100%; padding: 10px; font-size: 16px; }
  .stat-pos { color: #5ce65c; font-weight: bold; }
  .stat-neg { color: #ff4d4d; font-weight: bold; }
  
  .shop-header { display: flex; gap: 40px; align-items: center; margin-bottom: 10px; }
  .inflation-tag {
    background: #441111; border: 1px solid #ff4444; color: #ff8888;
    padding: 4px 10px; border-radius: 4px; font-size: 14px; font-weight: bold;
  }
  .stats-panel {
    background: #1a1a22; border: 1px solid #333; padding: 15px 25px;
    border-radius: 8px; display: flex; gap: 18px; font-size: 13px; margin-bottom: 15px; flex-wrap: wrap; justify-content: center;
  }
</style>
</head>
<body>

<canvas id="gameCanvas" width="1100" height="750"></canvas>

<div id="ui-layer">
  <div class="hud-top">
    <div class="bars">
      <div class="bar-container">
        <div id="hp-fill" class="bar-fill"></div>
        <div id="hp-text" class="bar-text">12 / 12</div>
      </div>
      <div class="bar-container">
        <div id="xp-fill" class="bar-fill"></div>
        <div id="xp-text" class="bar-text">LVL 1 (0/25)</div>
      </div>
    </div>
    <div class="wave-info">
      <div id="wave-num">WAVE 1</div>
      <div id="wave-timer">20</div>
    </div>
    <div class="resources">
      <div>Materials: <span id="mat-count">0</span></div>
      <div style="font-size:14px; color:#aaa; margin-top:4px;">Weapons: <span id="wep-count">1/6</span></div>
      <div id="cache-countdown" style="font-size:12px; color:#ffcc00; margin-top:4px;">Weapon Cache: Wave 3</div>
    </div>
  </div>
</div>

<!-- Start Screen -->
<div id="start-screen" class="modal">
  <h1>TATERHELL</h1>
  <p class="subtitle">12 Deadly Enemy Types. Brutal XP & Hyper-Inflation (+35%/wave). Every 3 waves you unlock a free <b>Weapon Cache</b> choice. Use <b>WASD</b> or <b>Arrow Keys</b> to survive 20 waves.</p>
  <button onclick="startGame()">ENTER THE ARENA</button>
</div>

<!-- Weapon Choice Cache Modal -->
<div id="weapon-modal" class="modal hidden">
  <h2 style="color:#ffcc00; font-size:36px;">SUPPLY DROP: WEAPON CACHE</h2>
  <p style="color:#aaa;">Pick a free weapon to add to your arsenal (or salvage for materials if full)</p>
  <div id="weapon-cards" class="cards-container"></div>
</div>

<!-- Level Up Modal -->
<div id="levelup-modal" class="modal hidden">
  <h2 style="color:#2eb8e6; font-size:36px;">LEVEL UP!</h2>
  <p style="color:#aaa;">Rare mutation unlocked — choose wisely</p>
  <div id="levelup-cards" class="cards-container"></div>
</div>

<!-- Shop Modal -->
<div id="shop-modal" class="modal hidden">
  <div class="shop-header">
    <h2 style="color:#5ce65c; font-size:36px;">BLACK MARKET</h2>
    <div style="font-size:24px; font-weight:bold;">Materials: <span id="shop-mats" style="color:#5ce65c;">0</span></div>
    <div id="inflation-badge" class="inflation-tag">INFLATION: +0%</div>
  </div>
  <div id="player-stats-display" class="stats-panel"></div>
  <div id="shop-cards" class="cards-container"></div>
  <div style="display:flex; gap:20px; margin-top:10px;">
    <button id="reroll-btn" onclick="rerollShop()" style="background:#335577; border-color:#5588bb;">Reroll (15)</button>
    <button onclick="nextWave()">NEXT WAVE &rarr;</button>
  </div>
</div>

<!-- Game Over / Victory -->
<div id="end-screen" class="modal hidden">
  <h1 id="end-title">SQUASHED</h1>
  <p id="end-desc" class="subtitle">You were mashed on Wave 1.</p>
  <button onclick="startGame()">TRY AGAIN</button>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

// Game Constants & State
const MAX_WAVES = 20;
const INFLATION_RATE = 0.35;
let gameState = 'START';
let wave = 1;
let waveTimer = 20;
let lastTime = 0;
let rerollCost = 15;

const keys = {};
window.addEventListener('keydown', e => keys[e.key.toLowerCase()] = true);
window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

// Player Object
let player = {};
function resetPlayer() {
  player = {
    x: canvas.width / 2,
    y: canvas.height / 2,
    radius: 18,
    hp: 12,
    maxHp: 12,
    speed: 250,
    damageMult: 1.0,
    attackSpeed: 1.0,
    armor: 0,
    dodge: 0,
    lifesteal: 0,
    critChance: 5,
    pickupRange: 105,
    hpRegen: 0,
    regenTimer: 3.0,
    range: 0,
    materials: 0,
    xp: 0,
    level: 1,
    nextXp: 25,
    pendingLevelUps: 0,
    invuln: 0,
    weapons: [createWeapon('pistol')]
  };
}

// Weapon Definitions
const WEAPON_TYPES = {
  pistol: { name: 'Rusty Pistol', dmg: 12, cd: 0.9, range: 360, speed: 650, color: '#cccccc', cost: 24, desc: 'Balanced single-shot sidearm.' },
  smg: { name: 'Scrap SMG', dmg: 5, cd: 0.22, range: 300, speed: 700, color: '#ffaa00', cost: 34, desc: 'High fire rate, low accuracy.' },
  shotgun: { name: 'Boomstick', dmg: 7, cd: 1.35, range: 260, speed: 600, color: '#ff4444', pellets: 5, cost: 38, desc: 'Fires 5 pellets in a tight spread.' },
  sniper: { name: 'Rail-Spud', dmg: 45, cd: 2.1, range: 600, speed: 1100, color: '#00ffff', pierce: 3, cost: 52, desc: 'Pierces 3 enemies. Huge damage.' },
  blade: { name: 'Circular Saw', dmg: 18, cd: 0.65, range: 115, speed: 0, melee: true, color: '#ff66ff', cost: 30, desc: 'Fast close-range melee sweep.' },
  flamer: { name: 'Spud Torch', dmg: 4, cd: 0.12, range: 210, speed: 480, color: '#ff6600', pierce: 1, cost: 36, desc: 'Rapid close-range flame stream.' }
};

function createWeapon(typeKey) {
  return { ...WEAPON_TYPES[typeKey], key: typeKey, timer: 0, angle: 0 };
}

// Entities
let enemies = [];
let projectiles = [];
let enemyProjectiles = [];
let drops = [];
let particles = [];
let explosions = [];
let spawnIndicators = [];
let floatingTexts = [];
let spawnTimer = 0;

// Upgrades Pool (18 Total)
const UPGRADES = [
  { name: 'Glass Cannon', desc: '<span class="stat-pos">+30% Damage</span><br><span class="stat-neg">-3 Max HP</span>', apply: () => { player.damageMult += 0.3; player.maxHp = Math.max(1, player.maxHp - 3); player.hp = Math.min(player.hp, player.maxHp); } },
  { name: 'Adrenaline', desc: '<span class="stat-pos">+25% Attack Speed</span><br><span class="stat-neg">-5 Armor</span>', apply: () => { player.attackSpeed += 0.25; player.armor -= 5; } },
  { name: 'Thick Skin', desc: '<span class="stat-pos">+5 Max HP, +4 Armor</span><br><span class="stat-neg">-8% Speed</span>', apply: () => { player.maxHp += 5; player.hp += 5; player.armor += 4; player.speed *= 0.92; } },
  { name: 'Track Shoes', desc: '<span class="stat-pos">+18% Speed, +8% Dodge</span>', apply: () => { player.speed *= 1.18; player.dodge = Math.min(65, player.dodge + 8); } },
  { name: 'Vampiric Fangs', desc: '<span class="stat-pos">+12% Lifesteal</span><br><span class="stat-neg">-2 Max HP</span>', apply: () => { player.lifesteal += 12; player.maxHp = Math.max(1, player.maxHp - 2); player.hp = Math.min(player.hp, player.maxHp); } },
  { name: 'Scope Lens', desc: '<span class="stat-pos">+70 Range, +15% Damage</span>', apply: () => { player.range += 70; player.damageMult += 0.15; } },
  { name: 'Steroids', desc: '<span class="stat-pos">+20% Damage, +15% Atk Spd</span><br><span class="stat-neg">-10% Dodge</span>', apply: () => { player.damageMult += 0.2; player.attackSpeed += 0.15; player.dodge -= 10; } },
  { name: 'Second Wind', desc: '<span class="stat-pos">Heal Full HP, +4 Max HP</span>', apply: () => { player.maxHp += 4; player.hp = player.maxHp; } },
  { name: 'Heavy Caliber', desc: '<span class="stat-pos">+45% Damage</span><br><span class="stat-neg">-15% Attack Speed</span>', apply: () => { player.damageMult += 0.45; player.attackSpeed = Math.max(0.25, player.attackSpeed - 0.15); } },
  { name: 'Trigger Finger', desc: '<span class="stat-pos">+35% Attack Speed</span><br><span class="stat-neg">-12% Damage</span>', apply: () => { player.attackSpeed += 0.35; player.damageMult = Math.max(0.25, player.damageMult - 0.12); } },
  { name: 'Blood Pact', desc: '<span class="stat-pos">+15% Lifesteal, +20% Damage</span><br><span class="stat-neg">-4 Max HP</span>', apply: () => { player.lifesteal += 15; player.damageMult += 0.2; player.maxHp = Math.max(1, player.maxHp - 4); player.hp = Math.min(player.hp, player.maxHp); } },
  { name: 'Sniper Eye', desc: '<span class="stat-pos">+25% Crit Chance, +100 Range</span><br><span class="stat-neg">-10% Speed</span>', apply: () => { player.critChance = Math.min(100, player.critChance + 25); player.range += 100; player.speed *= 0.9; } },
  { name: 'Teflon Coat', desc: '<span class="stat-pos">+15% Dodge, +3 Armor</span><br><span class="stat-neg">-3 Max HP</span>', apply: () => { player.dodge = Math.min(65, player.dodge + 15); player.armor += 3; player.maxHp = Math.max(1, player.maxHp - 3); player.hp = Math.min(player.hp, player.maxHp); } },
  { name: 'Juggernaut', desc: '<span class="stat-pos">+8 Max HP, +6 Armor</span><br><span class="stat-neg">-15% Speed, -10% Dodge</span>', apply: () => { player.maxHp += 8; player.hp += 8; player.armor += 6; player.speed *= 0.85; player.dodge -= 10; } },
  { name: 'Overclocked', desc: '<span class="stat-pos">+20% Speed, +20% Atk Spd</span><br><span class="stat-neg">-4 Armor</span>', apply: () => { player.speed *= 1.2; player.attackSpeed += 0.2; player.armor -= 4; } },
  { name: 'Greed Magnet', desc: '<span class="stat-pos">+90 Pickup Range</span><br><span class="stat-neg">-2 Max HP</span>', apply: () => { player.pickupRange += 90; player.maxHp = Math.max(1, player.maxHp - 2); player.hp = Math.min(player.hp, player.maxHp); } },
  { name: 'Regenerator', desc: '<span class="stat-pos">+1 HP Regen (every 3s)</span><br><span class="stat-neg">-8% Damage</span>', apply: () => { player.hpRegen += 1; player.damageMult = Math.max(0.25, player.damageMult - 0.08); } },
  { name: 'Berserker', desc: '<span class="stat-pos">+40% Damage, +15% Speed</span><br><span class="stat-neg">-8 Armor</span>', apply: () => { player.damageMult += 0.4; player.speed *= 1.15; player.armor -= 8; } }
];

function startGame() {
  resetPlayer();
  wave = 1;
  document.getElementById('start-screen').classList.add('hidden');
  document.getElementById('end-screen').classList.add('hidden');
  startWave();
  lastTime = performance.now();
  requestAnimationFrame(gameLoop);
}

function startWave() {
  gameState = 'PLAYING';
  waveTimer = Math.min(45, 20 + Math.floor(wave * 1.3));
  enemies = [];
  projectiles = [];
  enemyProjectiles = [];
  spawnIndicators = [];
  explosions = [];
  drops = [];
  spawnTimer = 0.5;
  player.x = canvas.width / 2;
  player.y = canvas.height / 2;
  player.hp = Math.min(player.maxHp, player.hp + Math.ceil(player.maxHp * 0.2));
  document.getElementById('shop-modal').classList.add('hidden');
  updateHUD();
}

function gameLoop(now) {
  const dt = Math.min(0.05, (now - lastTime) / 1000);
  lastTime = now;

  if (gameState === 'PLAYING') {
    update(dt);
    draw();
  }
  requestAnimationFrame(gameLoop);
}

function update(dt) {
  waveTimer -= dt;
  if (waveTimer <= 0) {
    endWave();
    return;
  }

  // HP Regen Tick
  if (player.hpRegen > 0 && player.hp < player.maxHp) {
    player.regenTimer -= dt;
    if (player.regenTimer <= 0) {
      player.hp = Math.min(player.maxHp, player.hp + player.hpRegen);
      addFloatingText(player.x, player.y - 25, `+${player.hpRegen}`, '#5ce65c');
      player.regenTimer = 3.0;
    }
  }

  // Player Movement
  let mx = 0, my = 0;
  if (keys['w'] || keys['arrowup']) my -= 1;
  if (keys['s'] || keys['arrowdown']) my += 1;
  if (keys['a'] || keys['arrowleft']) mx -= 1;
  if (keys['d'] || keys['arrowright']) mx += 1;
  if (mx !== 0 && my !== 0) {
    const inv = 1 / Math.sqrt(2);
    mx *= inv; my *= inv;
  }
  player.x = Math.max(player.radius, Math.min(canvas.width - player.radius, player.x + mx * player.speed * dt));
  player.y = Math.max(player.radius, Math.min(canvas.height - player.radius, player.y + my * player.speed * dt));

  if (player.invuln > 0) player.invuln -= dt;

  // Spawning Logic
  spawnTimer -= dt;
  if (spawnTimer <= 0) {
    const batchSize = 2 + Math.floor(wave * 0.75);
    for (let i = 0; i < batchSize; i++) queueEnemySpawn();
    spawnTimer = Math.max(0.45, 1.8 - wave * 0.065);
  }

  // Process Spawn Indicators
  for (let i = spawnIndicators.length - 1; i >= 0; i--) {
    let s = spawnIndicators[i];
    s.timer -= dt;
    if (s.timer <= 0) {
      if (s.type === 'swarmer') {
        for (let k = 0; k < 3; k++) {
          spawnEnemy(s.x + (Math.random()-0.5)*30, s.y + (Math.random()-0.5)*30, 'swarmer');
        }
      } else {
        spawnEnemy(s.x, s.y, s.type);
      }
      spawnIndicators.splice(i, 1);
    }
  }

  // Weapons Auto-Aim & Fire
  player.weapons.forEach((w) => {
    w.timer -= dt * player.attackSpeed;
    const effectiveRange = w.range + player.range;
    let target = findNearestEnemy(player.x, player.y, effectiveRange);
    if (target) {
      w.angle = Math.atan2(target.y - player.y, target.x - player.x);
      if (w.timer <= 0) {
        fireWeapon(w);
        w.timer = w.cd;
      }
    }
  });

  // Update Player Projectiles
  for (let i = projectiles.length - 1; i >= 0; i--) {
    let p = projectiles[i];
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.life -= dt;
    if (p.life <= 0) { projectiles.splice(i, 1); continue; }

    for (let j = enemies.length - 1; j >= 0; j--) {
      let e = enemies[j];
      if (!p.hitList.includes(e) && dist(p.x, p.y, e.x, e.y) < p.radius + e.radius) {
        damageEnemy(e, p.dmg, p.vx * 0.08, p.vy * 0.08);
        p.hitList.push(e);
        if (p.pierce > 0) {
          p.pierce--;
        } else {
          projectiles.splice(i, 1);
          break;
        }
      }
    }
  }

  // Update Enemies (12 Types)
  for (let i = enemies.length - 1; i >= 0; i--) {
    let e = enemies[i];
    const ang = Math.atan2(player.y - e.y, player.x - e.x);
    const dToPlayer = dist(e.x, e.y, player.x, player.y);

    if (e.type === 'charger') {
      e.chargeTimer -= dt;
      if (e.charging) {
        e.x += Math.cos(e.chargeAng) * e.speed * 3.2 * dt;
        e.y += Math.sin(e.chargeAng) * e.speed * 3.2 * dt;
        if (e.chargeTimer <= 0) { e.charging = false; e.chargeTimer = 2.0; }
      } else {
        e.x += Math.cos(ang) * e.speed * 0.6 * dt;
        e.y += Math.sin(ang) * e.speed * 0.6 * dt;
        if (e.chargeTimer <= 0 && dToPlayer < 350) {
          e.charging = true;
          e.chargeAng = ang;
          e.chargeTimer = 0.45;
        }
      }
    } else if (e.type === 'spitter') {
      if (dToPlayer > 280) {
        e.x += Math.cos(ang) * e.speed * dt;
        e.y += Math.sin(ang) * e.speed * dt;
      }
      e.shootTimer -= dt;
      if (e.shootTimer <= 0) {
        enemyProjectiles.push({
          x: e.x, y: e.y,
          vx: Math.cos(ang) * (260 + wave * 8),
          vy: Math.sin(ang) * (260 + wave * 8),
          radius: 6, dmg: Math.ceil(3 + wave * 0.8), color: '#ff2266'
        });
        e.shootTimer = Math.max(1.1, 2.4 - wave * 0.05);
      }
    } else if (e.type === 'sniper') {
      if (dToPlayer > 430) {
        e.x += Math.cos(ang) * e.speed * dt;
        e.y += Math.sin(ang) * e.speed * dt;
      } else if (dToPlayer < 320) {
        e.x -= Math.cos(ang) * e.speed * 0.8 * dt;
        e.y -= Math.sin(ang) * e.speed * 0.8 * dt;
      }
      e.shootTimer -= dt;
      e.aiming = e.shootTimer < 0.85;
      e.aimAng = ang;
      if (e.shootTimer <= 0) {
        enemyProjectiles.push({
          x: e.x, y: e.y,
          vx: Math.cos(ang) * 680,
          vy: Math.sin(ang) * 680,
          radius: 5, dmg: Math.ceil(5 + wave * 1.1), color: '#ff0000'
        });
        e.shootTimer = 3.2;
      }
    } else if (e.type === 'warden') {
      if (dToPlayer > 250) {
        e.x += Math.cos(ang) * e.speed * dt;
        e.y += Math.sin(ang) * e.speed * dt;
      }
      e.shootTimer -= dt;
      if (e.shootTimer <= 0) {
        [-0.25, 0, 0.25].forEach(offset => {
          enemyProjectiles.push({
            x: e.x, y: e.y,
            vx: Math.cos(ang + offset) * 250,
            vy: Math.sin(ang + offset) * 250,
            radius: 6, dmg: Math.ceil(3 + wave * 0.7), color: '#00ccff'
          });
        });
        e.shootTimer = 2.6;
      }
    } else if (e.type === 'bomber') {
      e.x += Math.cos(ang) * e.speed * dt;
      e.y += Math.sin(ang) * e.speed * dt;
      if (dToPlayer < e.radius + player.radius + 18) {
        triggerExplosion(e.x, e.y, 75, e.dmg * 1.5);
        enemies.splice(i, 1);
        continue;
      }
    } else if (e.type === 'ghost') {
      e.phaseTimer -= dt;
      if (e.phaseTimer <= 0) {
        e.phased = !e.phased;
        e.phaseTimer = e.phased ? 1.4 : 2.0;
      }
      const spdMult = e.phased ? 1.85 : 0.85;
      e.x += Math.cos(ang) * e.speed * spdMult * dt;
      e.y += Math.sin(ang) * e.speed * spdMult * dt;
    } else if (e.type === 'healer') {
      if (dToPlayer > 240) {
        e.x += Math.cos(ang) * e.speed * dt;
        e.y += Math.sin(ang) * e.speed * dt;
      }
      e.healTimer -= dt;
      if (e.healTimer <= 0) {
        e.healPulse = 0.4;
        enemies.forEach(other => {
          if (other !== e && dist(e.x, e.y, other.x, other.y) < 150) {
            other.hp = Math.min(other.maxHp, other.hp + other.maxHp * 0.25);
          }
        });
        e.healTimer = 3.0;
      }
      if (e.healPulse > 0) e.healPulse -= dt;
    } else {
      // Rusher, Swarmer, Brute, Splitter, Juggernaut
      e.x += Math.cos(ang) * e.speed * dt;
      e.y += Math.sin(ang) * e.speed * dt;
    }

    e.x += e.kx * dt; e.y += e.ky * dt;
    e.kx *= 0.85; e.ky *= 0.85;

    if (dist(e.x, e.y, player.x, player.y) < e.radius + player.radius) {
      damagePlayer(e.dmg);
    }
  }

  // Update Enemy Projectiles
  for (let i = enemyProjectiles.length - 1; i >= 0; i--) {
    let ep = enemyProjectiles[i];
    ep.x += ep.vx * dt;
    ep.y += ep.vy * dt;
    if (ep.x < 0 || ep.x > canvas.width || ep.y < 0 || ep.y > canvas.height) {
      enemyProjectiles.splice(i, 1);
      continue;
    }
    if (dist(ep.x, ep.y, player.x, player.y) < ep.radius + player.radius) {
      damagePlayer(ep.dmg);
      enemyProjectiles.splice(i, 1);
    }
  }

  // Update Explosions
  for (let i = explosions.length - 1; i >= 0; i--) {
    explosions[i].life -= dt;
    if (explosions[i].life <= 0) explosions.splice(i, 1);
  }

  // Update Drops
  for (let i = drops.length - 1; i >= 0; i--) {
    let d = drops[i];
    d.life -= dt;
    if (d.life <= 0) { drops.splice(i, 1); continue; }
    const distToPlayer = dist(d.x, d.y, player.x, player.y);
    if (distToPlayer < player.pickupRange) {
      const ang = Math.atan2(player.y - d.y, player.x - d.x);
      d.x += Math.cos(ang) * 440 * dt;
      d.y += Math.sin(ang) * 440 * dt;
    }
    if (distToPlayer < player.radius + 10) {
      player.materials += d.val;
      player.xp += d.xpVal;
      checkLevelUp();
      drops.splice(i, 1);
    }
  }

  // Particles & Floating Texts
  for (let i = particles.length - 1; i >= 0; i--) {
    let pt = particles[i];
    pt.x += pt.vx * dt; pt.y += pt.vy * dt; pt.life -= dt;
    if (pt.life <= 0) particles.splice(i, 1);
  }
  for (let i = floatingTexts.length - 1; i >= 0; i--) {
    let ft = floatingTexts[i];
    ft.y -= 35 * dt; ft.life -= dt;
    if (ft.life <= 0) floatingTexts.splice(i, 1);
  }

  updateHUD();
}

function queueEnemySpawn() {
  const pad = 45;
  const x = pad + Math.random() * (canvas.width - pad * 2);
  const y = pad + Math.random() * (canvas.height - pad * 2);
  
  const pool = ['rusher'];
  if (wave >= 2) pool.push('spitter', 'swarmer');
  if (wave >= 3) pool.push('charger', 'sniper');
  if (wave >= 4) pool.push('brute', 'bomber');
  if (wave >= 5) pool.push('splitter');
  if (wave >= 6) pool.push('warden');
  if (wave >= 7) pool.push('ghost');
  if (wave >= 8) pool.push('healer');
  if (wave >= 10) pool.push('juggernaut');

  const type = pool[Math.floor(Math.random() * pool.length)];
  spawnIndicators.push({ x, y, type, timer: 0.9 });
}

function spawnEnemy(x, y, type) {
  const scale = 1 + (wave - 1) * 0.28;
  const base = { x, y, type, kx: 0, ky: 0 };

  switch (type) {
    case 'rusher':
      enemies.push({ ...base, radius: 13, hp: 14 * scale, maxHp: 14 * scale, speed: 175 + wave * 5, dmg: Math.ceil(3 * scale), color: '#ff4444', val: 1, xpVal: 1 });
      break;
    case 'swarmer':
      enemies.push({ ...base, radius: 8, hp: 6 * scale, maxHp: 6 * scale, speed: 235 + wave * 5, dmg: Math.ceil(2 * scale), color: '#ffee44', val: 1, xpVal: 1 });
      break;
    case 'spitter':
      enemies.push({ ...base, radius: 15, hp: 18 * scale, maxHp: 18 * scale, speed: 110, dmg: Math.ceil(2 * scale), color: '#b84dff', shootTimer: 1.2, val: 2, xpVal: 1 });
      break;
    case 'charger':
      enemies.push({ ...base, radius: 16, hp: 24 * scale, maxHp: 24 * scale, speed: 140, dmg: Math.ceil(4 * scale), color: '#ff8800', chargeTimer: 1.0, charging: false, chargeAng: 0, val: 2, xpVal: 1 });
      break;
    case 'sniper':
      enemies.push({ ...base, radius: 14, hp: 16 * scale, maxHp: 16 * scale, speed: 95, dmg: Math.ceil(3 * scale), color: '#ff0055', shootTimer: 2.2, aiming: false, aimAng: 0, val: 3, xpVal: 2 });
      break;
    case 'bomber':
      enemies.push({ ...base, radius: 14, hp: 15 * scale, maxHp: 15 * scale, speed: 205 + wave * 4, dmg: Math.ceil(5 * scale), color: '#ff5500', val: 2, xpVal: 1 });
      break;
    case 'brute':
      enemies.push({ ...base, radius: 25, hp: 75 * scale, maxHp: 75 * scale, speed: 85 + wave * 2, dmg: Math.ceil(6 * scale), color: '#990033', val: 4, xpVal: 2 });
      break;
    case 'splitter':
      enemies.push({ ...base, radius: 19, hp: 34 * scale, maxHp: 34 * scale, speed: 125, dmg: Math.ceil(4 * scale), color: '#33cc99', val: 2, xpVal: 1 });
      break;
    case 'warden':
      enemies.push({ ...base, radius: 18, hp: 42 * scale, maxHp: 42 * scale, speed: 95, dmg: Math.ceil(4 * scale), color: '#0088ff', shootTimer: 1.8, val: 3, xpVal: 2 });
      break;
    case 'ghost':
      enemies.push({ ...base, radius: 14, hp: 22 * scale, maxHp: 22 * scale, speed: 145, dmg: Math.ceil(4 * scale), color: '#aaccff', phaseTimer: 1.5, phased: false, val: 3, xpVal: 2 });
      break;
    case 'healer':
      enemies.push({ ...base, radius: 16, hp: 28 * scale, maxHp: 28 * scale, speed: 105, dmg: Math.ceil(2 * scale), color: '#22dd55', healTimer: 2.0, healPulse: 0, val: 3, xpVal: 2 });
      break;
    case 'juggernaut':
      enemies.push({ ...base, radius: 34, hp: 180 * scale, maxHp: 180 * scale, speed: 58 + wave * 1.5, dmg: Math.ceil(9 * scale), color: '#551122', val: 7, xpVal: 4 });
      break;
  }
}

function triggerExplosion(x, y, radius, dmg) {
  explosions.push({ x, y, radius, life: 0.3 });
  spawnParticles(x, y, '#ff6600', 18);
  if (dist(x, y, player.x, player.y) < radius + player.radius) {
    damagePlayer(dmg);
  }
}

function fireWeapon(w) {
  const dmg = Math.max(1, Math.round(w.dmg * player.damageMult));
  if (w.melee) {
    spawnParticles(player.x + Math.cos(w.angle)*50, player.y + Math.sin(w.angle)*50, w.color, 8);
    enemies.forEach(e => {
      if (dist(player.x, player.y, e.x, e.y) <= w.range + player.range + e.radius) {
        damageEnemy(e, dmg, Math.cos(w.angle)*250, Math.sin(w.angle)*250);
      }
    });
    return;
  }

  const pellets = w.pellets || 1;
  for (let i = 0; i < pellets; i++) {
    const spread = pellets > 1 ? (Math.random() - 0.5) * 0.45 : ((w.key === 'smg' || w.key === 'flamer') ? (Math.random() - 0.5) * 0.25 : 0);
    const ang = w.angle + spread;
    projectiles.push({
      x: player.x, y: player.y,
      vx: Math.cos(ang) * w.speed,
      vy: Math.sin(ang) * w.speed,
      radius: w.key === 'sniper' ? 5 : (w.key === 'flamer' ? 6 : 4),
      dmg: dmg,
      pierce: w.pierce || 0,
      hitList: [],
      color: w.color,
      life: (w.range + player.range) / w.speed
    });
  }
}

function damageEnemy(e, baseDmg, kx, ky) {
  const isCrit = Math.random() * 100 < player.critChance;
  const finalDmg = isCrit ? baseDmg * 2 : baseDmg;

  e.hp -= finalDmg;
  // Juggernauts resist knockback
  const kbResist = e.type === 'juggernaut' ? 0.15 : 1.0;
  e.kx += kx * kbResist; e.ky += ky * kbResist;
  addFloatingText(e.x, e.y - 10, isCrit ? `${finalDmg}!` : finalDmg, isCrit ? '#ffcc00' : '#ffffff');
  spawnParticles(e.x, e.y, e.color, 4);

  if (player.lifesteal > 0 && Math.random() * 100 < player.lifesteal) {
    if (player.hp < player.maxHp) {
      player.hp++;
      addFloatingText(player.x, player.y - 20, '+1', '#5ce65c');
    }
  }

  if (e.hp <= 0) {
    const idx = enemies.indexOf(e);
    if (idx > -1) enemies.splice(idx, 1);
    spawnParticles(e.x, e.y, e.color, 12);

    // On-Death Enemy Effects
    if (e.type === 'splitter') {
      spawnEnemy(e.x - 12, e.y, 'swarmer');
      spawnEnemy(e.x + 12, e.y, 'swarmer');
    } else if (e.type === 'bomber') {
      triggerExplosion(e.x, e.y, 70, e.dmg * 1.2);
    }

    drops.push({ x: e.x, y: e.y, val: e.val, xpVal: e.xpVal, life: 6.0 });
  }
}

function damagePlayer(rawDmg) {
  if (player.invuln > 0) return;

  if (Math.random() * 100 < player.dodge) {
    addFloatingText(player.x, player.y - 20, 'DODGE!', '#2eb8e6');
    player.invuln = 0.4;
    return;
  }

  const mitigation = player.armor >= 0 ? (10 / (10 + player.armor)) : (1 - player.armor * 0.08);
  const finalDmg = Math.max(1, Math.round(rawDmg * mitigation));

  player.hp -= finalDmg;
  player.invuln = 0.55;
  addFloatingText(player.x, player.y - 20, `-${finalDmg}`, '#ff3333');
  spawnParticles(player.x, player.y, '#ff0000', 15);

  if (player.hp <= 0) {
    player.hp = 0;
    updateHUD();
    gameState = 'END';
    document.getElementById('end-title').innerText = 'MASHED';
    document.getElementById('end-title').style.color = '#ff3333';
    document.getElementById('end-desc').innerText = `You survived until Wave ${wave} at Level ${player.level}.`;
    document.getElementById('end-screen').classList.remove('hidden');
  }
}

function checkLevelUp() {
  while (player.xp >= player.nextXp) {
    player.xp -= player.nextXp;
    player.level++;
    player.nextXp = Math.round(player.nextXp * 1.65 + 20);
    player.pendingLevelUps++;
  }
}

function endWave() {
  if (wave >= MAX_WAVES) {
    gameState = 'END';
    document.getElementById('end-title').innerText = 'APEX SPUD!';
    document.getElementById('end-title').style.color = '#5ce65c';
    document.getElementById('end-desc').innerText = 'Impossible! You conquered all 12 enemy types and the hyper-inflated arena.';
    document.getElementById('end-screen').classList.remove('hidden');
    return;
  }

  // Every 3rd wave grants a free Weapon Cache choice before level-ups/shop
  if (wave % 3 === 0) {
    showWeaponChoiceModal();
  } else if (player.pendingLevelUps > 0) {
    showLevelUpModal();
  } else {
    openShop();
  }
}

function showWeaponChoiceModal() {
  gameState = 'WEAPON_CHOICE';
  const container = document.getElementById('weapon-cards');
  container.innerHTML = '';
  const wepKeys = Object.keys(WEAPON_TYPES).sort(() => 0.5 - Math.random()).slice(0, 3);
  const full = player.weapons.length >= 6;
  const salvageValue = 15 + wave * 5;

  wepKeys.forEach(k => {
    const w = WEAPON_TYPES[k];
    const card = document.createElement('div');
    card.className = 'card';
    card.innerHTML = `
      <div>
        <h3 style="color:${w.color}">${w.name}</h3>
        <p>DMG: ${w.dmg} | CD: ${w.cd}s<br>${w.desc}</p>
      </div>
      <button style="background:#b38600; border-color:#ffcc00;">
        ${full ? `SALVAGE (+${salvageValue} MATS)` : 'EQUIP FREE'}
      </button>
    `;
    card.querySelector('button').onclick = () => {
      if (full) {
        player.materials += salvageValue;
      } else {
        player.weapons.push(createWeapon(k));
      }
      document.getElementById('weapon-modal').classList.add('hidden');
      if (player.pendingLevelUps > 0) {
        showLevelUpModal();
      } else {
        openShop();
      }
    };
    container.appendChild(card);
  });

  document.getElementById('weapon-modal').classList.remove('hidden');
}

function showLevelUpModal() {
  gameState = 'LEVELUP';
  const container = document.getElementById('levelup-cards');
  container.innerHTML = '';
  const choices = [...UPGRADES].sort(() => 0.5 - Math.random()).slice(0, 3);
  
  choices.forEach(upg => {
    const card = document.createElement('div');
    card.className = 'card';
    card.innerHTML = `<div><h3>${upg.name}</h3><p>${upg.desc}</p></div><button>SELECT</button>`;
    card.querySelector('button').onclick = () => {
      upg.apply();
      player.pendingLevelUps--;
      if (player.pendingLevelUps > 0) {
        showLevelUpModal();
      } else {
        document.getElementById('levelup-modal').classList.add('hidden');
        openShop();
      }
    };
    container.appendChild(card);
  });
  document.getElementById('levelup-modal').classList.remove('hidden');
}

function openShop() {
  gameState = 'SHOP';
  rerollCost = Math.round(10 + wave * 5);
  renderShopItems();
  document.getElementById('shop-modal').classList.remove('hidden');
}

function getInflationMultiplier() {
  return 1 + (wave - 1) * INFLATION_RATE;
}

function renderShopItems() {
  const infMult = getInflationMultiplier();
  const infPct = Math.round((infMult - 1) * 100);

  document.getElementById('shop-mats').innerText = player.materials;
  document.getElementById('inflation-badge').innerText = `INFLATION: +${infPct}%`;
  document.getElementById('reroll-btn').innerText = `Reroll (${rerollCost})`;
  document.getElementById('reroll-btn').disabled = player.materials < rerollCost;
  document.getElementById('reroll-btn').style.opacity = player.materials < rerollCost ? '0.4' : '1';

  document.getElementById('player-stats-display').innerHTML = `
    <div>HP: <b>${player.hp}/${player.maxHp}</b></div>
    <div>DMG: <b>${Math.round(player.damageMult*100)}%</b></div>
    <div>ATK SPD: <b>${Math.round(player.attackSpeed*100)}%</b></div>
    <div>CRIT: <b>${player.critChance}%</b></div>
    <div>ARMOR: <b>${player.armor}</b></div>
    <div>DODGE: <b>${player.dodge}%</b></div>
    <div>REGEN: <b>${player.hpRegen}/3s</b></div>
    <div>SPEED: <b>${Math.round(player.speed)}</b></div>
    <div>WEAPONS: <b>${player.weapons.length}/6</b></div>
  `;

  const container = document.getElementById('shop-cards');
  container.innerHTML = '';
  const wepKeys = Object.keys(WEAPON_TYPES);

  for (let i = 0; i < 4; i++) {
    const isWep = Math.random() < 0.45;
    const card = document.createElement('div');
    card.className = 'card';

    if (isWep) {
      const k = wepKeys[Math.floor(Math.random() * wepKeys.length)];
      const w = WEAPON_TYPES[k];
      const cost = Math.round(w.cost * infMult);
      const full = player.weapons.length >= 6;
      card.innerHTML = `
        <div>
          <h3 style="color:${w.color}">${w.name}</h3>
          <p>DMG: ${w.dmg} | CD: ${w.cd}s<br>${w.desc}</p>
        </div>
        <button ${player.materials < cost || full ? 'disabled style="opacity:0.4;cursor:not-allowed;"' : ''}>
          ${full ? 'SLOTS FULL' : `BUY (${cost})`}
        </button>
      `;
      if (!full && player.materials >= cost) {
        card.querySelector('button').onclick = () => {
          player.materials -= cost;
          player.weapons.push(createWeapon(k));
          renderShopItems();
        };
      }
    } else {
      const upg = UPGRADES[Math.floor(Math.random() * UPGRADES.length)];
      const baseCost = 26;
      const cost = Math.round(baseCost * infMult);
      card.innerHTML = `
        <div><h3>${upg.name}</h3><p>${upg.desc}</p></div>
        <button ${player.materials < cost ? 'disabled style="opacity:0.4;cursor:not-allowed;"' : ''}>BUY (${cost})</button>
      `;
      if (player.materials >= cost) {
        card.querySelector('button').onclick = (e) => {
          player.materials -= cost;
          upg.apply();
          e.target.disabled = true;
          e.target.innerText = 'SOLD';
          renderShopItems();
        };
      }
    }
    container.appendChild(card);
  }
}

function rerollShop() {
  if (player.materials >= rerollCost) {
    player.materials -= rerollCost;
    rerollCost = Math.round(rerollCost * 1.8);
    renderShopItems();
  }
}

function nextWave() {
  wave++;
  startWave();
}

// Rendering
function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  ctx.strokeStyle = '#22222c';
  ctx.lineWidth = 1;
  for (let x = 0; x < canvas.width; x += 50) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
  for (let y = 0; y < canvas.height; y += 50) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }

  // Explosions
  explosions.forEach(ex => {
    ctx.fillStyle = `rgba(255, 100, 0, ${ex.life * 2})`;
    ctx.beginPath();
    ctx.arc(ex.x, ex.y, ex.radius, 0, Math.PI * 2);
    ctx.fill();
  });

  // Spawn Indicators
  spawnIndicators.forEach(s => {
    ctx.strokeStyle = `rgba(255, 50, 50, ${1 - s.timer})`;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(s.x - 12, s.y - 12); ctx.lineTo(s.x + 12, s.y + 12);
    ctx.moveTo(s.x + 12, s.y - 12); ctx.lineTo(s.x - 12, s.y + 12);
    ctx.stroke();
  });

  // Drops
  drops.forEach(d => {
    ctx.fillStyle = d.life < 2.0 && Math.floor(d.life * 10) % 2 === 0 ? '#ffffff' : '#5ce65c';
    ctx.beginPath();
    ctx.arc(d.x, d.y, 6, 0, Math.PI * 2);
    ctx.fill();
  });

  // Player
  ctx.save();
  if (player.invuln > 0 && Math.floor(player.invuln * 20) % 2 === 0) ctx.globalAlpha = 0.4;
  ctx.fillStyle = '#d9a066';
  ctx.strokeStyle = '#734d26';
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.ellipse(player.x, player.y, player.radius, player.radius * 1.18, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.stroke();
  ctx.fillStyle = '#111';
  ctx.beginPath();
  ctx.arc(player.x - 6, player.y - 4, 2.5, 0, Math.PI * 2);
  ctx.arc(player.x + 6, player.y - 4, 2.5, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();

  // Weapons
  player.weapons.forEach((w, idx) => {
    const orbitAng = (idx / player.weapons.length) * Math.PI * 2;
    const wx = player.x + Math.cos(orbitAng) * 32;
    const wy = player.y + Math.sin(orbitAng) * 32;
    ctx.save();
    ctx.translate(wx, wy);
    ctx.rotate(w.angle);
    ctx.fillStyle = w.color;
    ctx.fillRect(-6, -3, 16, 6);
    ctx.restore();
  });

  // Enemies & Special Visuals
  enemies.forEach(e => {
    ctx.save();
    if (e.type === 'ghost' && e.phased) ctx.globalAlpha = 0.3;

    // Sniper Laser Sight
    if (e.type === 'sniper' && e.aiming) {
      ctx.strokeStyle = 'rgba(255, 0, 0, 0.55)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(e.x, e.y);
      ctx.lineTo(e.x + Math.cos(e.aimAng) * 700, e.y + Math.sin(e.aimAng) * 700);
      ctx.stroke();
    }

    // Healer Aura Pulse
    if (e.type === 'healer' && e.healPulse > 0) {
      ctx.strokeStyle = 'rgba(40, 255, 100, 0.6)';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(e.x, e.y, 150, 0, Math.PI * 2);
      ctx.stroke();
    }

    ctx.fillStyle = e.color;
    ctx.beginPath();
    ctx.arc(e.x, e.y, e.radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = e.type === 'juggernaut' ? '#ffaa00' : '#000';
    ctx.lineWidth = e.type === 'juggernaut' ? 4 : 2;
    ctx.stroke();
    ctx.restore();
  });

  // Projectiles
  projectiles.forEach(p => {
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
    ctx.fill();
  });

  enemyProjectiles.forEach(ep => {
    ctx.fillStyle = ep.color || '#ff2266';
    ctx.beginPath();
    ctx.arc(ep.x, ep.y, ep.radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1.5;
    ctx.stroke();
  });

  particles.forEach(pt => {
    ctx.fillStyle = pt.color;
    ctx.fillRect(pt.x, pt.y, 4, 4);
  });

  ctx.font = 'bold 14px sans-serif';
  ctx.textAlign = 'center';
  floatingTexts.forEach(ft => {
    ctx.fillStyle = ft.color;
    ctx.fillText(ft.text, ft.x, ft.y);
  });
}

// Helpers
function dist(x1, y1, x2, y2) { return Math.hypot(x2 - x1, y2 - y1); }

function findNearestEnemy(x, y, maxRange) {
  let best = null, bestDist = maxRange;
  enemies.forEach(e => {
    const d = dist(x, y, e.x, e.y);
    if (d < bestDist) { bestDist = d; best = e; }
  });
  return best;
}

function spawnParticles(x, y, color, count) {
  for (let i = 0; i < count; i++) {
    const ang = Math.random() * Math.PI * 2;
    const spd = 40 + Math.random() * 140;
    particles.push({ x, y, vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd, color, life: 0.35 });
  }
}

function addFloatingText(x, y, text, color) {
  floatingTexts.push({ x, y, text, color, life: 0.65 });
}

function updateHUD() {
  document.getElementById('hp-fill').style.width = `${(player.hp / player.maxHp) * 100}%`;
  document.getElementById('hp-text').innerText = `${player.hp} / ${player.maxHp}`;
  document.getElementById('xp-fill').style.width = `${(player.xp / player.nextXp) * 100}%`;
  document.getElementById('xp-text').innerText = `LVL ${player.level} (${player.xp}/${player.nextXp})`;
  document.getElementById('wave-num').innerText = `WAVE ${wave} / ${MAX_WAVES}`;
  document.getElementById('wave-timer').innerText = Math.ceil(waveTimer);
  document.getElementById('mat-count').innerText = player.materials;
  document.getElementById('wep-count').innerText = `${player.weapons.length}/6`;

  const nextCacheWave = Math.ceil(wave / 3) * 3;
  document.getElementById('cache-countdown').innerText = nextCacheWave <= MAX_WAVES 
    ? `Weapon Cache: After Wave ${nextCacheWave}` 
    : 'All Caches Claimed';
}
</script>
</body>
</html>
